; Clock-controlled rows: only the successful request's own XID is refreshed.
(ttl_ms 20)
(steps (())
 (() (at_ms 0) (room "one")
     (req (self "a") (peer "b") (values (()) "" "payload") (next "a1"))
     (res (self "a")) (rows (()) "a") (rooms 1))
 (() (at_ms 5) (room "one")
     (req (self "b") (peer "a") (values (()) "reply") (next "b1"))
     (res (self "b") (values (()) "" "payload") (next "a1"))
     (rows (()) "b" "a") (rooms 1))
 (() (at_ms 19) (room "one") (req (self "a") (next "a1"))
     (res (self "a") (values (()) "reply") (next "b1")) (rows (()) "a" "b") (rooms 1))
 ; Reading B at19 did not refresh B's expiry at25. Expiration is inclusive.
 (() (at_ms 25) (room "one") (req (self "a") (next "a1"))
     (res (self "a")) (rows (()) "a") (rooms 1))
 ; A rejected request cannot extend A's deadline from45.
 (() (at_ms 39) (room "one") (req (self "a") (next "wrong"))
     (reject +true) (rows (()) "a") (rooms 1))
 (() (at_ms 45) (room "one") (req (self "a") (next "a1"))
     (reject +true) (rows (())) (rooms 0))
 ; Actual full snapshots, not references or fabricated successor rows, restore the pair.
 (() (at_ms 46) (room "one")
     (req (self "a") (peer "b") (values (()) "" "payload") (next "a1"))
     (res (self "a")) (rows (()) "a") (rooms 1))
 (() (at_ms 47) (room "one")
     (req (self "b") (peer "a") (values (()) "reply") (next "b1"))
     (res (self "b") (values (()) "" "payload") (next "a1"))
     (rows (()) "b" "a") (rooms 1))
 (() (at_ms 48) (room "one") (req (self "a") (next "a1"))
     (res (self "a") (values (()) "reply") (next "b1")) (rows (()) "a" "b") (rooms 1))
 (() (at_ms 49) (room "two") (req (self "other")) (res (self "other"))
     (rows (()) "other") (rooms 2))
 (() (at_ms 67) (room "one") (req (self "a") (next "a1"))
     (res (self "a")) (rows (()) "a") (rooms 2))
 ; Idle rooms are reclaimed without a request to those rooms.
 (() (at_ms 69) (sweep +true) (rooms 1))
 (() (at_ms 87) (sweep +true) (rooms 0)))
