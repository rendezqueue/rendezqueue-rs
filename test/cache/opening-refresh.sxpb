(ttl_ms 20)
(steps (())
 (() (at_ms 0) (room "presence") (req (self "a")) (res (self "a"))
     (rows (()) "a") (rooms 1))
 (() (at_ms 2) (room "presence") (req (self "b")) (res (self "b") (peer "a"))
     (rows (()) "b" "a") (rooms 1))
 ; Opening retries refresh only their own row and do not reorder existing rows.
 (() (at_ms 19) (room "presence") (req (self "a")) (res (self "a") (peer "b"))
     (rows (()) "b" "a") (rooms 1))
 (() (at_ms 22) (room "presence") (req (self "a")) (res (self "a"))
     (rows (()) "a") (rooms 1))
 (() (at_ms 23) (room "presence") (req (self "a") (peer "a")) (reject +true)
     (rows (()) "a") (rooms 1))
 (() (at_ms 42) (sweep +true) (rooms 0))
 ; A nonempty XID expires; missing references do not leave unbounded rooms.
 (() (at_ms 50) (room "empty") (req (self "x")) (res (self "x"))
     (rows (()) "x") (rooms 1))
 (() (at_ms 70) (room "empty") (req (self "x") (next "next")) (reject +true)
     (rows (())) (rooms 0)))
