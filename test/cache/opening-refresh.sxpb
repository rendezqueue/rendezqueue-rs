(ttl_ms 20)
(steps (())
 (() (at_ms 0) (room "presence") (req (sid "a")) (res (sid "a"))
     (rows (()) "a") (rooms 1))
 (() (at_ms 2) (room "presence") (req (sid "b")) (res (sid "b") (ack "a"))
     (rows (()) "b" "a") (rooms 1))
 ; Opening retries refresh only their own row and do not reorder existing rows.
 (() (at_ms 19) (room "presence") (req (sid "a")) (res (sid "a") (ack "b"))
     (rows (()) "b" "a") (rooms 1))
 (() (at_ms 22) (room "presence") (req (sid "a")) (res (sid "a"))
     (rows (()) "a") (rooms 1))
 (() (at_ms 23) (room "presence") (req (sid "a") (ack "a")) (reject +true)
     (rows (()) "a") (rooms 1))
 (() (at_ms 42) (sweep +true) (rooms 0))
 ; Empty SID bytes are a real identity, not absence; no unbounded missing-reference room.
 (() (at_ms 50) (room "empty") (req (sid "")) (res (sid ""))
     (rows (()) "") (rooms 1))
 (() (at_ms 70) (room "empty") (req (sid "") (nxt "next")) (reject +true)
     (rows (())) (rooms 0)))
